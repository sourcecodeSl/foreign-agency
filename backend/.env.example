# --- Email (Gmail SMTP) ------------------------------------------------------
# SMTP_PASS must be a Google APP PASSWORD (16 chars), not your normal password.
# Create one at https://myaccount.google.com/apppasswords
# (requires 2-Step Verification to be switched on first).
# Leave SMTP_USER/SMTP_PASS empty to keep logging codes to the console instead.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=visaltheekshana555@gmail.com
SMTP_PASS=
SMTP_FROM="Agency Admin" <visaltheekshana555@gmail.com>

