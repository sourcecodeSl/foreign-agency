# Copy to .env

# true  -> screens run on the built-in mock adapter, no backend needed
# false -> calls the live Laravel API, proxied to XAMPP's Apache (see vite.config.js)
VITE_USE_MOCK=true

VITE_API_URL=/api/v1

# Where the dev server proxies /api. Defaults to XAMPP's Apache; uncomment to
# use `php artisan serve` instead.
# API_PROXY_TARGET=http://127.0.0.1:8000
